{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Squaresandbox Connector Test",
            "program": "${workspaceFolder}/target/debug/deps/connectors-23f3e5ad60c77170",
            "args": [
                "squearesandbox::should_only_authorize_payment",
                "--nocapture",
                "--test-threads=1"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "CONNECTOR_AUTH_FILE_PATH": "${workspaceFolder}/crates/router/tests/connectors/auth.toml",
                "RUST_TEST_THREADS": "1",
                "RUST_BACKTRACE": "short",
                "HTTPS_PROXY":"http://127.0.0.1:8888"
            },
            "console": "integratedTerminal",
            "stopOnEntry": false,
            "preLaunchTask": "build-square-test",
            "sourceLanguages": ["rust"],
            "initCommands": [
                "settings set target.inline-breakpoint-strategy always"
            ]
        }
        
    ]
}
